# Mealventory AI Microservice Environment Configuration

# -----------------------------------------------------------------------------
# 1. Gemini Multimodal Vision API (Tickets AI-01, AI-02, AI-05)
# -----------------------------------------------------------------------------
# Provide your Google Gemini API key here.
# TIP: Set GEMINI_API_KEY=mock to activate deterministic zero-cost mock vision 
# engine for local/offline testing without consuming API quota (Ticket AI-05).
GEMINI_API_KEY=your-gemini-api-key-or-mock

# -----------------------------------------------------------------------------
# 2. Google Cloud Vision OCR (Legacy/Fallback OCR Engine)
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=credentials/[google-credentials-file].json

# -----------------------------------------------------------------------------
# 3. Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
